# LabX — Plantilla de variables de entorno para PRODUCCIÓN
# ============================================================
# INSTRUCCIONES:
#   1. Copiar este archivo como .env en el servidor de producción
#   2. Reemplazar TODOS los valores marcados con <CAMBIAR>
#   3. NUNCA commitear .env con valores reales al repositorio
#   4. Verificar con: python -c "from api.coach_main import app" — debe arrancar sin errores

# ── Base de datos ─────────────────────────────────────────────
# PostgreSQL obligatorio en producción (SQLite = startup abortado)
DATABASE_URL=postgresql://labx_user:<CAMBIAR_PASSWORD>@db:5432/labx_prod

# ── Seguridad — TODAS OBLIGATORIAS EN PRODUCCIÓN ─────────────
# JWT: mínimo 32 caracteres aleatorios. Generar:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<CAMBIAR_MINIMO_64_CHARS_ALEATORIOS>

# Fernet: exactamente 32 bytes en base64. Generar:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=<CAMBIAR_FERNET_KEY_BASE64>
# Clave anterior (solo al rotar FERNET_KEY — mantiene compatibilidad con credenciales existentes)
# FERNET_KEY_OLD=<CLAVE_ANTERIOR>

# Password del admin (hash bcrypt). Generar:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt()).decode())"
ADMIN_PASS=<CAMBIAR_BCRYPT_HASH>

# ── CORS ─────────────────────────────────────────────────────
# Dominios exactos, separados por coma. Sin comodines en producción.
CORS_ORIGINS=https://app.labx.io,https://labx.io

# ── App ──────────────────────────────────────────────────────
APP_ENV=production
TOKEN_HOURS=8
ENABLE_DOCS=0

# ── Observabilidad ───────────────────────────────────────────
# Crear proyecto en https://sentry.io/ y copiar el DSN aquí
SENTRY_DSN=https://<CAMBIAR>@o<ID>.ingest.sentry.io/<PROJECT_ID>

# ── Stripe ───────────────────────────────────────────────────
# Obtener en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_<CAMBIAR>
STRIPE_WEBHOOK_SECRET=whsec_<CAMBIAR>

# ── Garmin (cuenta de servicio del sistema, no del usuario) ──
# Se usa para sync automático vía Celery
GARMIN_EMAIL=<CAMBIAR>
GARMIN_PASSWORD=<CAMBIAR>

# ── IA Coach ─────────────────────────────────────────────────
# Obtener en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-<CAMBIAR>
# Modelo a usar (opciones: claude-haiku-4-5-20251001, claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Storage ──────────────────────────────────────────────────
# Opciones: local | s3
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=<CAMBIAR>
AWS_SECRET_ACCESS_KEY=<CAMBIAR>
AWS_S3_BUCKET=labx-prod-storage
AWS_REGION=us-east-1

# ── Backups ──────────────────────────────────────────────────
# Días a mantener backups locales antes de limpiar
BACKUP_KEEP_DAYS=30

# ── Email ────────────────────────────────────────────────────
# API key de Resend (https://resend.com)
# Dominio de envio verificado en Resend: labxperformanceapp.com
RESEND_API_KEY=re_<CAMBIAR>
EMAIL_FROM=LabX <bienvenida@labxperformanceapp.com>

# ── Seguridad adicional ───────────────────────────────────────
# Audience del JWT (debe coincidir con el valor al momento de crear tokens)
JWT_AUDIENCE=labx-app

# Metrics endpoint protection (si se accede desde fuera del loopback)
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_SECRET=<CAMBIAR_METRICS_SECRET>

# ── PostgreSQL (docker-compose) ───────────────────────────────
POSTGRES_USER=labx
POSTGRES_PASSWORD=<CAMBIAR_POSTGRES_PASSWORD>
POSTGRES_DB=labx_prod

# ── App URL pública ───────────────────────────────────────────
APP_URL=https://beta.labx.app

# ── Admin seed ───────────────────────────────────────────────
ADMIN_EMAIL=admin@labx.app
ADMIN_NOMBRE=Admin

# ── Push Notifications (VAPID) ───────────────────────────────
# Generar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<CAMBIAR_VAPID_PUBLIC>
VAPID_PRIVATE_KEY=<CAMBIAR_VAPID_PRIVATE>
VAPID_SUBJECT=mailto:admin@labx.app

# ── Strava OAuth ─────────────────────────────────────────────
# Registrar app en https://www.strava.com/settings/api
STRAVA_CLIENT_ID=<CAMBIAR>
STRAVA_CLIENT_SECRET=<CAMBIAR>
STRAVA_REDIRECT_URI=https://beta.labx.app/api/strava/callback

# ── Wearables adicionales (Sprint 50+, ver docs/plan-multi-brand-wearables.md) ──
# Apagados por defecto: no implementados, o pendientes de validar con un
# usuario real de esa marca antes de habilitar en producción.
WAHOO_ENABLED=false
POLAR_ENABLED=false
COROS_ENABLED=false
APPLE_HEALTH_ENABLED=false

# ── Garmin OAuth ─────────────────────────────────────────────
GARMIN_CLIENT_ID=<CAMBIAR>
GARMIN_CLIENT_SECRET=<CAMBIAR>
GARMIN_REDIRECT_URI=https://beta.labx.app/api/garmin/callback

# ── Stripe plans ─────────────────────────────────────────────
STRIPE_PRICE_PRO=price_<CAMBIAR>
STRIPE_PRICE_COACH=price_<CAMBIAR>
STRIPE_PRICE_ELITE=price_<CAMBIAR>
STRIPE_TRIAL_DAYS=14

# ── Deploy tag (se sobreescribe en deploy.sh) ─────────────────
DEPLOY_TAG=latest
