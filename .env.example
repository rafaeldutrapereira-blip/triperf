# ─────────────────────────────────────────────────────
# LabX — Variables de entorno
# Copiar este archivo a .env y completar los valores
# NUNCA commitear .env al repositorio
# ─────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────
# SQLite (desarrollo local):
DATABASE_URL=sqlite:///./data/labx_coach.db
# PostgreSQL (producción — descomentar y completar):
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/labx_db

# ── Seguridad JWT ─────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIAR-EN-PRODUCCION-usar-token-aleatorio-256bits
TOKEN_HOURS=8

# ── Cifrado Garmin (Fernet) ───────────────────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CAMBIAR-EN-PRODUCCION-generar-clave-fernet
# Al rotar FERNET_KEY, mover la clave antigua aquí para seguir descifrando credenciales existentes
FERNET_KEY_OLD=

# ── CORS ─────────────────────────────────────────────
# Producción: dominio real (separado por comas)
# CORS_ORIGINS=https://labx.app,https://www.labx.app
# Desarrollo: dejar vacío para permitir *
CORS_ORIGINS=

# ── Email (Resend.com) ────────────────────────────────
# Obtener en: https://resend.com
RESEND_API_KEY=re_XXXXXXXX
EMAIL_FROM=noreply@labx.app

# ── Pagos (Stripe) ────────────────────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_PRO=price_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_COACH=price_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── App ───────────────────────────────────────────────
APP_ENV=development
# Producción: APP_ENV=production  ENABLE_DOCS=0
ENABLE_DOCS=1
PORT=8000
APP_URL=http://localhost:8000

# ── Admin seed (primer deploy) ────────────────────────
# Cambiar ANTES de deploy. Se usa solo si no existen usuarios.
ADMIN_EMAIL=admin@labx.app
ADMIN_PASS=CAMBIAR-EN-PRODUCCION-minimo-16-caracteres
ADMIN_NOMBRE=Admin
DEMO_EMAIL=demo@labx.app
DEMO_PASS=CAMBIAR-EN-PRODUCCION-minimo-16-caracteres

# ── Sentry (monitoreo de errores) ─────────────────────
# Obtener en: https://sentry.io (plan free disponible)
SENTRY_DSN=

# ── Web Push (VAPID — notificaciones push) ────────────
# Generar con: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@labx.app

# ── Garmin OAuth ──────────────────────────────────────
# Registrar en: https://developer.garmin.com/gc-developer-program/
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Producción: https://labx.app/api/garmin/callback
GARMIN_REDIRECT_URI=http://localhost:8000/api/garmin/callback

# ── Strava OAuth ───────────────────────────────────────
# Crear app en: https://www.strava.com/settings/api
# Authorization Callback Domain: labx.app
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Producción: https://labx.app/api/strava/callback
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback

# ── Wearables adicionales (Sprint 50+, ver docs/plan-multi-brand-wearables.md) ──
# Apagados por defecto: no implementados todavía, o pendientes de validar
# con un usuario real de esa marca antes de habilitar en producción.
WAHOO_ENABLED=false
POLAR_ENABLED=false
COROS_ENABLED=false
APPLE_HEALTH_ENABLED=false

# ── AI / Anthropic ─────────────────────────────────────
# Para Coach AI Copilot (chat — opcional, resto del AI es determinista)
ANTHROPIC_API_KEY=

# ── Redis (opcional — rate-limit cache) ───────────────
# Sin REDIS_URL el sistema funciona con fallback DB
# Local: redis://localhost:6379/0
# Upstash TLS: rediss://user:password@host:6379/0
REDIS_URL=
